{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/assets/css/:path*", "destination": "/:path*" },
    { "source": "/assets/js/:path*", "destination": "/:path*" },
    { "source": "/assets/images/profile-photo.png", "destination": "/profile-photo.png" },
    { "source": "/assets/images/profile-photo.jpg", "destination": "/profile-photo.png" },
    { "source": "/assets/images/profile-photo.svg", "destination": "/profile-photo.png" },
    { "source": "/assets/images/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
